                  {
                    "name": "[variables('avdSubnetName')]",
                    "properties": {
                      "addressPrefix": "[parameters('avdSubnetPrefix')]",
                      "networkSecurityGroup": "[if(parameters('enableAvdSubnet'), createObject('id', resourceId('Microsoft.Network/networkSecurityGroups', format('nsg-spoke{0}-avd', parameters('spokeNumber')))), null())]"
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityGroups', format('nsg-spoke{0}-avd', parameters('spokeNumber')))]",
                "[resourceId('Microsoft.Network/networkSecurityGroups', format('nsg-spoke{0}-cloudpc', parameters('spokeNumber')))]",
                "[resourceId('Microsoft.Network/networkSecurityGroups', format('nsg-spoke{0}-mgmt', parameters('spokeNumber')))]"
              ]
            },
            {
              "condition": "[not(empty(parameters('hubVnetId')))]",
              "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}/{1}', parameters('vnetName'), 'peer-to-hub')]",
