                  },
                  {
                    "name": "Allow-DNS-Outbound",
                    "properties": {
                      "description": "Allow DNS outbound",
                      "protocol": "*",
                      "sourcePortRange": "*",
                      "destinationPortRange": "53",
                      "sourceAddressPrefix": "*",
                      "destinationAddressPrefix": "*",
                      "access": "Allow",
                      "priority": 110,
                      "direction": "Outbound"
                    }
                  }
                ]
              }
