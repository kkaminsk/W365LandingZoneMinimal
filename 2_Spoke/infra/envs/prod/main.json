              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "7729295378054917377"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for all resources"
              }
            },
            "vnetName": {
              "type": "string",
              "defaultValue": "vnet-w365-spokes",
              "metadata": {
                "description": "Name of the consolidated spoke virtual network"
              }
            },
            "vnetAddressSpace": {
              "type": "string",
              "defaultValue": "192.168.0.0/16",
              "metadata": {
                "description": "Address space for the consolidated VNet (192.168.0.0/16 for all spokes)"
              }
            },
            "spokeNumber": {
              "type": "int",
              "defaultValue": 1,
              "minValue": 1,
              "maxValue": 40,
              "metadata": {
                "description": "Spoke number (1-40) for unique subnet naming"
              }
            },
            "cloudPCSubnetPrefix": {
              "type": "string",
              "metadata": {
                "description": "Address prefix for the Windows 365 Cloud PC subnet"
